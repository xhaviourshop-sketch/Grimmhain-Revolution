{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "WebFetch",
      "mcp__puppeteer",
      "mcp__puppeteer__*"
    ],
    "deny": [
      "Bash(rm -rf ~/)",
      "Bash(rm -rf /*)",
      "Read(../)",
      "Edit(../)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_CODE_REMOTE\" ] && bash \"$CLAUDE_PROJECT_DIR/tools/cloud/setup-godot.sh\" || true"
          }
        ]
      }
    ]
  }
}
