* text=auto

# Legacy game-logic mirror (js/) is copied verbatim from the LF Grimmhain
# source by scripts/sync-legacy.mjs. Pin LF for store AND checkout so a re-sync
# never shows pure CRLF/LF diffs.
js/**/*.js text eol=lf

# Assetregister: immer LF, auch auf Windows-Checkouts. Das Prüfwerkzeug
# akzeptiert CRLF ebenfalls; die feste Regel hält die versionierte Datei kanonisch.
docs/masterplan/asset-register.csv text eol=lf

# OFL-Lizenztexte sind wörtliche Upstream-Kopien (siehe docs/assets/FONTS.md) und enthalten
# Leerzeichen am Zeilenende. Nicht bereinigen; git diff --check prüft sie deshalb nicht.
assets/fonts/OFL-*.txt -whitespace

# Windows-Starter: CRLF, damit cmd.exe Bloecke und Umleitungen sicher liest.
*.cmd text eol=crlf

# PE-07: echte Spielstand-Fixtures muessen bytegleich bleiben (kein Zeilenenden-Umbau).
godot/tests/saves/** -text
