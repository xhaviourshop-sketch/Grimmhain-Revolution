[gd_scene format=3]

[ext_resource type="Script" path="res://app/screens/new_game/new_game_screen.gd" id="1_screen"]
[ext_resource type="PackedScene" path="res://app/widgets/header_bar/header_bar.tscn" id="2_header"]

[node name="NewGameScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_screen")
screen_id = &"new_game"

[node name="Layout" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"ScreenMargin"

[node name="Column" type="VBoxContainer" parent="Layout"]
layout_mode = 2

[node name="HeaderBar" parent="Layout/Column" instance=ExtResource("2_header")]
unique_name_in_owner = true
layout_mode = 2
title_key = "ui.prep.title"

[node name="Content" type="VBoxContainer" parent="Layout/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="Footer" type="HBoxContainer" parent="Layout/Column"]
unique_name_in_owner = true
layout_mode = 2
