[gd_scene format=3]

[ext_resource type="Script" path="res://app/screens/new_game/new_game_screen.gd" id="1_screen"]
[ext_resource type="Script" path="res://app/widgets/grimm_label.gd" id="3_label"]
[ext_resource type="PackedScene" path="res://app/widgets/header_bar/header_bar.tscn" id="4_header"]

[node name="NewGameScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_screen")
screen_id = &"new_game"

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"ScreenColumn"

[node name="HeaderBar" parent="Layout" instance=ExtResource("4_header")]
unique_name_in_owner = true
layout_mode = 2
title_key = "ui.new_game.title"

[node name="Center" type="CenterContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3

[node name="Card" type="PanelContainer" parent="Layout/Center"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CardPanel"

[node name="Column" type="VBoxContainer" parent="Layout/Center/Card"]
layout_mode = 2

[node name="HeadingLabel" type="Label" parent="Layout/Center/Card/Column"]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
script = ExtResource("3_label")
text_key = "ui.new_game.heading"

[node name="BodyLabel" type="Label" parent="Layout/Center/Card/Column"]
layout_mode = 2
script = ExtResource("3_label")
text_key = "ui.new_game.body"

[node name="HintLabel" type="Label" parent="Layout/Center/Card/Column"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
script = ExtResource("3_label")
text_key = "ui.new_game.hint"
