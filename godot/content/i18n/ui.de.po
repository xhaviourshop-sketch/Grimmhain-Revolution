msgid "ui.call.albtraumwolf"
msgstr "„Albtraumwolf, erwache. Zeige auf die Person, deren Fähigkeit du heute Nacht blockierst.“"

msgid "ui.call.blutpriester"
msgstr "„Blutpriester, erwache. Willst du heute ein Opfer bringen? Zeige darauf oder schüttle den Kopf.“"

msgid "ui.call.die_ewigen"
msgstr "„Ewige, erwacht. Zeigt gemeinsam auf die Person, die ihr prüfen wollt.“"

msgid "ui.call.die_gebundenen"
msgstr "„Gebundene, erwacht und seht einander an.“"

msgid "ui.call.doktor"
msgstr "„Doktor, erwache. Zeige auf zwei Personen, deren Blut du vergleichen willst.“"

msgid "ui.call.dorfchronistin"
msgstr "„Dorfchronistin, erwache. Ich zeige dir, wie viele Einzelgänger im Dorf sind.“"

msgid "ui.call.dorfschmied"
msgstr "„Dorfschmied, erwache. Willst du deine Waffe jetzt vergeben? Zeige auf die Person.“"

msgid "ui.call.dr_victor_frankenstein"
msgstr "„Doktor Frankenstein, erwache. Willst du einen Toten zurückholen? Zeige auf ihn.“"

msgid "ui.call.faehrtenleser"
msgstr "„Fährtenleser, erwache. Willst du heute die Fährte lesen?“"

msgid "ui.call.feuerteufel"
msgstr "„Feuerteufel, erwache. Zeige auf die Person, die du markieren willst.“"

msgid "ui.call.giftwolf"
msgstr "„Giftwolf, erwache. Willst du jemanden vergiften? Zeige auf die Person.“"

msgid "ui.call.grabraeuber"
msgstr "„Grabräuber, erwache. Willst du das Grab eines Toten plündern? Zeige auf ihn.“"

msgid "ui.call.hades"
msgstr "„Hades, erwache. Willst du mit deinen Lichtern jemanden holen? Zeige auf die Person.“"

msgid "ui.call.henker"
msgstr "„Henker, erwache. Zeige auf die Person, die bei der nächsten Hinrichtung mit stirbt.“"

msgid "ui.call.koenig_lykaon"
msgstr "„König Lykaon, erwache. Wähle einen Verbündeten und ein Opfer deiner Verwandlung.“"

msgid "ui.call.koenig"
msgstr "„König, erwache. Zeige auf eine Person aus dem Dorf, deren Rolle du erfahren willst.“"

msgid "ui.call.kopfgeldjaeger"
msgstr "„Kopfgeldjäger, erwache. Hier ist deine Liste.“"

msgid "ui.call.korrupter_richter"
msgstr "„Korrupter Richter, erwache. Zeige auf die Person, die morgen als nominiert gilt.“"

msgid "ui.call.kriegerin_des_lichts"
msgstr "„Kriegerin des Lichts, erwache. Willst du heute angreifen? Zeige auf die Person.“"

msgid "ui.call.kutscher"
msgstr "„Kutscher, erwache. Willst du drei Tote zurückholen? Zeige auf sie.“"

msgid "ui.call.loki"
msgstr "„Loki, erwache. Zeige auf zwei Personen, die du miteinander verbinden willst.“"

msgid "ui.call.maertyrerin"
msgstr "„Märtyrerin, erwache. Willst du dich für das Opfer der Nacht opfern?“"

msgid "ui.call.nekromant"
msgstr "„Nekromant, erwache. Willst du Tote opfern? Zeige auf drei von ihnen.“"

msgid "ui.call.parasit"
msgstr "„Parasit, erwache. Willst du einen neuen Wirt wählen? Zeige auf die Person.“"

msgid "ui.call.pestbringerin"
msgstr "„Pestbringerin, erwache. Zeige auf die Person, die du infizieren willst.“"

msgid "ui.call.prophet_des_untergangs"
msgstr "„Prophet des Untergangs, erwache. Zeige auf die Personen deiner Prophezeiung.“"

msgid "ui.call.rachsuechtiger_wolf"
msgstr "„Rachsüchtiger Wolf, erwache. Willst du einen anderen Wolf reißen? Zeige auf ihn.“"

msgid "ui.call.rattenfaenger"
msgstr "„Rattenfänger, erwache. Zeige auf eine oder zwei Personen, die du verzaubern willst.“"

msgid "ui.call.rotkaeppchen"
msgstr "„Rotkäppchen, erwache. Zeige auf die Person, bei der du Zuflucht suchst.“"

msgid "ui.call.schattenhund"
msgstr "„Schattenhund, erwache. Willst du das Dorf heute Nacht blockieren?“"

msgid "ui.call.schattenwanderer"
msgstr "„Schattenwanderer, erwache. Willst du dich mit jemandem verknüpfen? Zeige auf die Person.“"

msgid "ui.call.schicksalswolf"
msgstr "„Schicksalswolf, erwache. Zeige auf die Personen, die das Schicksal treffen soll.“"

msgid "ui.call.schutzgeist"
msgstr "„Schutzgeist, erwache. Zeige auf die Person, der du deinen Schild schenkst.“"

msgid "ui.call.schwarze_witwe"
msgstr "„Schwarze Witwe, erwache. Zeige auf die Person, die du umgarnen willst.“"

msgid "ui.call.seelentauscher"
msgstr "„Seelentauscher, erwache. Willst du zwei Seelen tauschen? Zeige auf die beiden.“"

msgid "ui.call.spuerhund"
msgstr "„Spürhund, erwache. Zeige auf drei Personen, an denen du schnüffeln willst.“"

msgid "ui.call.todesprediger"
msgstr "„Todesprediger, erwache. Sag mir leise, wann du sterben wirst.“"

msgid "ui.call.traumdeuter"
msgstr "„Traumdeuter, erwache. Ich zeige dir die Namen aus deinem Traum.“"

msgid "ui.call.verdammniswaechter"
msgstr "„Verdammniswächter, erwache. Wen soll der Angriff der Wölfe treffen?“"

msgid "ui.call.voodoo_priester"
msgstr "„Voodoo-Priester, erwache. Zeige auf die Person, die deine Puppe erhält.“"

msgid "ui.call.waldlaeufer"
msgstr "„Waldläufer, erwache. Ich zeige dir, wie viele Wölfe noch leben.“"

msgid "ui.call.zeitwaechter"
msgstr "„Zeitwächter, erwache. Willst du diese Nacht einfrieren?“"

msgid "ui.prompt.albtraumwolf.pick"
msgstr "Tippe die Person an, die der Albtraumwolf blockiert. Ohne Wahl: „Niemand / verzichten“."

msgid "ui.prompt.blutpriester.targets"
msgstr "Tippe das Opfer des Blutpriesters an. Es stirbt am Morgen. Ohne Opfer: verzichten."

msgid "ui.prompt.blutpriester.reveal"
msgstr "Nur für dich: Wähle bis zu drei lebende Wölfe, die du dem Blutpriester nennst."

msgid "ui.prompt.blutpriester.shown"
msgstr "Nenne dem Blutpriester die gewählten Wölfe. Danach „Gezeigt“."

msgid "ui.prompt.die_ewigen.targets"
msgstr "Tippe die Person an, die die Ewigen prüfen, und bestätige."

msgid "ui.prompt.die_ewigen.shown"
msgstr "Zeige den Ewigen, ob die Person allein gewinnen kann. Danach „Gezeigt“."

msgid "ui.prompt.die_gebundenen.shown"
msgstr "Die Gebundenen sehen einander. Danach „Gezeigt“."

