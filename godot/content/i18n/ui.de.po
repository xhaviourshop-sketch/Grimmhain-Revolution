msgid "ui.setup.error.entry"
msgstr "Eintrag {position} „{name}“: {reason}"

msgid "ui.setup.error.entries_more"
msgstr "… und {count} weitere"

msgid "ui.setup.error.also_too_many"
msgstr "Außerdem wären es mehr als {max} Spieler."

