msgid "ui.cockpit.dialog.skip.title"
msgstr "Schritt überspringen?"

msgid "ui.cockpit.dialog.skip.message"
msgstr "Der Schritt wird ohne Wirkung übersprungen und mit Begründung protokolliert."

msgid "ui.cockpit.dialog.skip.confirm"
msgstr "Überspringen"

msgid "ui.cockpit.dialog.cancel.title"
msgstr "Schritt abbrechen?"

msgid "ui.cockpit.dialog.cancel.message"
msgstr "Alle bisherigen Angaben dieses Schritts werden verworfen. Danach kann er neu begonnen werden."

msgid "ui.cockpit.dialog.cancel.confirm"
msgstr "Abbrechen und verwerfen"

msgid "ui.cockpit.dialog.reject_win.title"
msgstr "Alle Siege ablehnen?"

msgid "ui.cockpit.dialog.reject_win.message"
msgstr "Die Partie läuft weiter. Ein Sieg wird erst nach der nächsten relevanten Änderung erneut geprüft."

msgid "ui.cockpit.dialog.reject_win.confirm"
msgstr "Ablehnen"

msgid "ui.cockpit.dialog.confirm_win.title"
msgstr "Sieg bestätigen?"

msgid "ui.cockpit.dialog.confirm_win.message"
msgstr "Die Partie endet mit diesem Sieger. Alle übrigen Kandidaten gelten als nicht gewählt."

msgid "ui.cockpit.dialog.confirm_win.confirm"
msgstr "Sieg bestätigen"

msgid "ui.cockpit.dialog.override.title"
msgstr "Gezeigtes Ergebnis ändern"

msgid "ui.cockpit.dialog.override.message"
msgstr "Wähle die Rolle, die gezeigt werden soll. Wahrheit und ermitteltes Ergebnis bleiben gespeichert."

msgid "ui.cockpit.dialog.override_reason.title"
msgstr "Änderung begründen"

msgid "ui.cockpit.dialog.override_reason.message"
msgstr "Die Änderung wird mit Begründung protokolliert."

msgid "ui.cockpit.dialog.override_reason.confirm"
msgstr "Ändern"

msgid "ui.cockpit.error.generic"
msgstr "Fehler: Die Aktion wurde abgelehnt. Nichts wurde geändert."

msgid "ui.cockpit.error.invalid_target"
msgstr "Fehler: Diese Person ist hier nicht wählbar. Nichts wurde geändert."

msgid "ui.cockpit.error.invalid_target_count"
msgstr "Fehler: Die Anzahl der gewählten Personen passt nicht. Nichts wurde geändert."

msgid "ui.cockpit.error.no_wolf_selected"
msgstr "Fehler: Unter den Gewählten muss mindestens ein Wolf sein. Nichts wurde geändert."

msgid "ui.cockpit.error.reason_required"
msgstr "Fehler: Eine Begründung ist Pflicht. Nichts wurde geändert."

msgid "ui.cockpit.error.step_not_skippable"
msgstr "Fehler: Dieser Schritt kann nicht übersprungen werden. Nichts wurde geändert."

msgid "ui.cockpit.error.prompt_mismatch"
msgstr "Fehler: Der Schritt hat sich inzwischen geändert. Nichts wurde geändert."

msgid "ui.cockpit.error.no_open_prompt"
msgstr "Fehler: Kein Schritt ist offen. Nichts wurde geändert."

msgid "ui.cockpit.error.stage_mismatch"
msgstr "Fehler: Der Schritt ist schon weiter. Nichts wurde geändert."

msgid "ui.cockpit.error.invalid_answer"
msgstr "Fehler: Diese Antwort ist hier nicht möglich. Nichts wurde geändert."

msgid "ui.cockpit.error.invalid_prediction"
msgstr "Fehler: Dieser Zeitpunkt ist nicht möglich. Nichts wurde geändert."

msgid "ui.cockpit.error.no_change"
msgstr "Fehler: Das ist bereits das gezeigte Ergebnis. Nichts wurde geändert."

msgid "ui.cockpit.error.step_already_active"
msgstr "Fehler: Der Schritt läuft bereits. Nichts wurde geändert."

msgid "ui.cockpit.error.wrong_phase"
msgstr "Fehler: Das ist in dieser Phase nicht möglich. Nichts wurde geändert."

msgid "ui.cockpit.error.reaction_open"
msgstr "Fehler: Zuerst muss die offene Reaktion bearbeitet werden. Nichts wurde geändert."

msgid "ui.cockpit.error.win_candidate_open"
msgstr "Fehler: Zuerst muss über den möglichen Sieg entschieden werden. Nichts wurde geändert."

msgid "ui.cockpit.error.game_over"
msgstr "Fehler: Die Partie ist beendet. Nichts wurde geändert."

msgid "ui.cockpit.error.night_steps_open"
msgstr "Fehler: Es sind noch Nachtschritte offen. Nichts wurde geändert."

msgid "ui.cockpit.error.prompt_open"
msgstr "Fehler: Ein Schritt ist noch offen. Nichts wurde geändert."

msgid "ui.cockpit.error.player_dead"
msgstr "Fehler: Diese Person ist tot. Nichts wurde geändert."

msgid "ui.call.generic"
msgstr "„{role}, erwache.“"

msgid "ui.call.night_falls"
msgstr "„Die Nacht bricht herein. Das ganze Dorf schließt die Augen.“"

msgid "ui.call.pack"
msgstr "„Werwölfe, erwacht. Einigt euch still auf ein Opfer und zeigt es mir.“"

msgid "ui.call.schutzengel"
msgstr "„Schutzengel, erwache. Zeige auf die Person, die du heute Nacht beschützen willst.“"

msgid "ui.call.waldhexe"
msgstr "„Waldhexe, erwache. Ich zeige dir das Opfer der Nacht. Willst du einen Trank nutzen?“"

msgid "ui.call.das_orakel"
msgstr "„Orakel, erwache. Zeige auf die Person, deren Wesen du schauen willst.“"

msgid "ui.call.wolfskind"
msgstr "„Wolfskind, erwache. Zeige auf die Person, die dein Vorbild sein soll.“"

msgid "ui.call.lehrling"
msgstr "„Lehrling, erwache. Ich zeige dir gleich drei Rollen. Wähle deinen Meister.“"

msgid "ui.prompt.generic.targets"
msgstr "Wähle im Sitzkreis mindestens {min} und höchstens {max} Personen und bestätige."

msgid "ui.prompt.generic.choice"
msgstr "Frage die handelnde Person und tippe ihre Antwort."

msgid "ui.prompt.generic.ack"
msgstr "Zeige oder nenne das Ergebnis und bestätige danach."

msgid "ui.prompt.generic.option"
msgstr "Zeige die Optionen und tippe die gewählte an."

msgid "ui.prompt.generic.prediction"
msgstr "Stelle den vorhergesagten Zeitpunkt ein und bestätige."

msgid "ui.prompt.schutzengel.pick"
msgstr "Tippe die Person an, auf die der Schutzengel zeigt, und bestätige. Er darf sich nicht selbst schützen."

msgid "ui.prompt.pack.pick"
msgstr "Tippe das Opfer der Werwölfe an und bestätige. Ohne Einigung: „Niemand / verzichten“."

msgid "ui.prompt.pack2.pick"
msgstr "Zweites Opfer des Rudels: Tippe die Person an und bestätige. Es durchdringt Schutz."

msgid "ui.prompt.waldhexe.heal"
msgstr "Zeige der Waldhexe das Opfer. Nutzt sie den Heiltrank?"

msgid "ui.prompt.waldhexe.reveal"
msgstr "Die Waldhexe rettet. Zeige ihr jetzt die Rolle des Opfers."

msgid "ui.prompt.waldhexe.poison"
msgstr "Nutzt die Waldhexe den Gifttrank?"

msgid "ui.prompt.waldhexe.poison_target"
msgstr "Tippe die Person an, die die Waldhexe vergiftet, und bestätige."

msgid "ui.prompt.waldhexe.confirm"
msgstr "Prüfe die Zusammenfassung. Erst „Bestätigen“ wendet die Tränke an."

msgid "ui.prompt.das_orakel.target"
msgstr "Tippe die Person an, auf die das Orakel zeigt, und bestätige."

msgid "ui.prompt.das_orakel.shown"
msgstr "Zeige dem Orakel das Ergebnis, zum Beispiel über „Karte zeigen“. Danach „Gezeigt“."

msgid "ui.prompt.wolfskind.pick"
msgstr "Tippe das gewählte Vorbild an und bestätige."

msgid "ui.prompt.lehrling.candidates"
msgstr "Nur für dich: Wähle drei andere lebende Personen, deren Rollen der Lehrling zur Wahl bekommt."

msgid "ui.prompt.lehrling.option"
msgstr "Zeige dem Lehrling die drei Rollen (ohne Namen) und tippe seine Wahl an."

msgid "ui.prompt.lehrling.confirm"
msgstr "Bestätige die Wahl des Lehrlings. Erst jetzt entsteht die Bindung."

