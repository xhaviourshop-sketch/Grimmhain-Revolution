msgid "ui.setup.restart"
msgstr "Neu beginnen"

msgid "ui.setup.confirm"
msgstr "Spieler bestätigen"

msgid "ui.setup.status.confirmed"
msgstr "Bestätigt: {count} Spieler."

msgid "ui.setup.status.ready"
msgstr "Bereit zum Bestätigen."

msgid "ui.setup.status.incomplete"
msgstr "Noch {missing} Spieler bis zur Mindestzahl."

