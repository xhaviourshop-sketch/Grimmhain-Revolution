msgid "ui.setup.warning.duplicate_added"
msgstr "Hinweis: „{name}“ gibt es bereits. Beide bleiben getrennte Spieler."

msgid "ui.setup.warning.duplicate_renamed"
msgstr "Hinweis: „{name}“ gibt es jetzt mehrfach. Beide bleiben getrennte Spieler."

