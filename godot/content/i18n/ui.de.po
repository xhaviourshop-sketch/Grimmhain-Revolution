msgid "ui.setup.dialog.leave.continue"
msgstr "Weiter bearbeiten"

msgid "ui.setup.dialog.leave.keep"
msgstr "Entwurf behalten"

msgid "ui.setup.dialog.leave.discard"
msgstr "Entwurf verwerfen"

