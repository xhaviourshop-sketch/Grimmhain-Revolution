msgid "ui.history.dialog.delete.confirm"
msgstr "Delete"

msgid "ui.history.info.exported"
msgstr "Saved: {path}"

msgid "ui.history.info.deleted"
msgstr "Report deleted."

msgid "ui.history.error.export"
msgstr "Export not possible. Existing files stay unchanged."

msgid "ui.history.error.delete"
msgstr "Deleting is not possible. The history stays unchanged."

msgid "ui.history.error.save"
msgstr "The final report could not be saved in the history. The game is not affected. Open the report again to try once more."

msgid "ui.history.status.unreadable"
msgstr "The history could not be read. The damaged file was set aside and the list is empty."

msgid "ui.history.status.newer_version"
msgstr "The history file comes from a newer app version and was not loaded. It was set aside unchanged."

msgid "ui.history.status.skipped"
msgstr "{count} damaged entries were skipped."

msgid "ui.history.status.recovered"
msgstr "The history was loaded from the backup copy."

msgid "ui.report.title.public"
msgstr "Final report (public version)"

msgid "ui.report.title.gm"
msgstr "Final report (game master version)"

msgid "ui.report.note.public"
msgstr "This version contains what was made known at the table and, because the end of the game is confirmed, all roles at the end of the game, the winners and the winning condition. Secret goals, protection marks, private decisions and causes are left out."

msgid "ui.report.note.public_locked"
msgstr "The win confirmation was taken back. This version only contains details that were made known at the table. Roles, winners and the winning condition appear again after a new win confirmation."

msgid "ui.report.note.gm"
msgstr "For the game master only. This version contains all roles, causes and secret details."

msgid "ui.report.participants"
