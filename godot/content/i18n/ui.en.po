msgid "ui.report.win_reason"
msgstr "Win condition: {reason}"

msgid "ui.report.winners"
msgstr "Winning people: {names}"

msgid "ui.report.heading.roles"
msgstr "Roles at the end of the game"

msgid "ui.report.role_line"
msgstr "{name}: {role}"

msgid "ui.report.role_original"
msgstr "(originally {role})"

msgid "ui.report.heading.history"
msgstr "Course of the game"

msgid "ui.report.night"
msgstr "Night {number}"

msgid "ui.report.day"
msgstr "Day {number}"

msgid "ui.report.judge_nominator"
msgstr "Covered nomination: {judge} nominated {nominee}."

msgid "ui.report.execution_override"
msgstr "This execution of {name} was a game master correction without a nomination."

msgid "ui.report.execution_redirected"
msgstr "The execution of {name} was mirrored: {other} died instead."

msgid "ui.report.correction"
msgstr "Game master correction “{what}” on {name}. Reason: {reason}"

msgid "ui.report.correction_general"
msgstr "Game master correction “{what}”. Reason: {reason}"

msgid "ui.report.correction_other"
msgstr "change"

msgid "ui.report.cause_other"
msgstr "unknown cause"

msgid "ui.report.win_rejected"
msgstr "Win rejected. Reason: {reason}"

msgid "ui.report.win_not_chosen"
msgstr "Win not confirmed: another win was chosen."

msgid "ui.report.win"
msgstr "Win confirmed: {side}."

msgid "ui.report.other_events"
msgstr "Further game master details are not part of the report."

msgid "ui.report.no_history"
