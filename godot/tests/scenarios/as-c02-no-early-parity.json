{
  "id": "AS-C02",
  "title": "Keine vorzeitige Parität",
  "spec": "docs/specs/vertical-slice/acceptance-scenarios.md",
  "steps": [
    {
      "cmd": {
        "type": "StartGame",
        "payload": {
          "round_id": "as-c02",
          "seed": 1,
          "assignment": "manual",
          "players": [
            {
              "id": 1,
              "name": "A"
            },
            {
              "id": 2,
              "name": "B"
            },
            {
              "id": 3,
              "name": "C"
            },
            {
              "id": 4,
              "name": "D"
            },
            {
              "id": 5,
              "name": "E"
            },
            {
              "id": 6,
              "name": "F"
            }
          ],
          "seat_order": [
            1,
            2,
            3,
            4,
            5,
            6
          ],
          "roles": {
            "1": "werwolf",
            "2": "werwolf",
            "3": "dorfbewohner",
            "4": "dorfbewohner",
            "5": "dorfbewohner",
            "6": "dorfbewohner"
          }
        }
      }
    },
    {
      "cmd": {
        "type": "StartNight",
        "payload": {}
      },
      "expect": {
        "win_candidate": null
      }
    },
    {
      "cmd": {
        "type": "AnswerPrompt",
        "payload": {
          "prompt_id": 1,
          "targets": [
            6
          ]
        }
      },
      "expect": {
        "win_candidate": null
      }
    },
    {
      "cmd": {
        "type": "EndNight",
        "payload": {}
      },
      "expect": {
        "alive": [
          1,
          2,
          3,
          4,
          5
        ],
        "win_candidate": null,
        "no_event_types": [
          "WinDetected"
        ]
      }
    },
    {
      "cmd": {
        "type": "Nominate",
        "payload": {
          "nominator_id": 3,
          "nominee_id": 1
        }
      },
      "expect": {
        "win_candidate": null,
        "no_event_types": [
          "WinDetected"
        ]
      }
    },
    {
      "cmd": {
        "type": "DecideExecution",
        "payload": {
          "target_id": -1
        }
      },
      "expect": {
        "win_candidate": null,
        "no_event_types": [
          "WinDetected"
        ]
      }
    },
    {
      "cmd": {
        "type": "EndDay",
        "payload": {}
      },
      "expect": {
        "win_candidate": null
      }
    }
  ]
}
