{
  "id": "AS-C03",
  "title": "Tod des letzten Wolfs",
  "spec": "docs/specs/vertical-slice/acceptance-scenarios.md",
  "steps": [
    {
      "cmd": {
        "type": "StartGame",
        "payload": {
          "round_id": "as-c03",
          "seed": 1,
          "assignment": "manual",
          "players": [
            {
              "id": 1,
              "name": "A"
            },
            {
              "id": 2,
              "name": "B"
            },
            {
              "id": 3,
              "name": "C"
            },
            {
              "id": 4,
              "name": "D"
            },
            {
              "id": 5,
              "name": "E"
            },
            {
              "id": 6,
              "name": "F"
            }
          ],
          "seat_order": [
            1,
            2,
            3,
            4,
            5,
            6
          ],
          "roles": {
            "1": "werwolf",
            "2": "dorfbewohner",
            "3": "dorfbewohner",
            "4": "dorfbewohner",
            "5": "dorfbewohner",
            "6": "dorfbewohner"
          }
        }
      }
    },
    {
      "cmd": {
        "type": "StartNight",
        "payload": {}
      }
    },
    {
      "cmd": {
        "type": "AnswerPrompt",
        "payload": {
          "prompt_id": 1,
          "targets": [
            6
          ]
        }
      }
    },
    {
      "cmd": {
        "type": "EndNight",
        "payload": {}
      }
    },
    {
      "cmd": {
        "type": "Nominate",
        "payload": {
          "nominator_id": 1,
          "nominee_id": 2
        }
      }
    },
    {
      "cmd": {
        "type": "DecideExecution",
        "payload": {
          "target_id": 2
        }
      },
      "expect": {
        "alive": [
          1,
          3,
          4,
          5
        ],
        "win_candidate": null
      }
    },
    {
      "cmd": {
        "type": "EndDay",
        "payload": {}
      }
    },
    {
      "cmd": {
        "type": "StartNight",
        "payload": {}
      },
      "expect": {
        "night_number": 2
      }
    },
    {
      "cmd": {
        "type": "AnswerPrompt",
        "payload": {
          "prompt_id": 2,
          "targets": []
        }
      },
      "expect": {
        "events": [
          {
            "type": "PromptAnswered",
            "data": {
              "targets": []
            }
          }
        ]
      }
    },
    {
      "cmd": {
        "type": "EndNight",
        "payload": {}
      },
      "expect": {
        "alive": [
          1,
          3,
          4,
          5
        ],
        "day_number": 2,
        "no_event_types": [
          "SeatDied"
        ],
        "events": [
          {
            "type": "NoNightKill"
          }
        ]
      }
    },
    {
      "cmd": {
        "type": "Nominate",
        "payload": {
          "nominator_id": 3,
          "nominee_id": 1
        }
      }
    },
    {
      "cmd": {
        "type": "DecideExecution",
        "payload": {
          "target_id": 1
        }
      },
      "expect": {
        "alive": [
          3,
          4,
          5
        ],
        "win_candidate": {
          "kind": "village",
          "reason_key": "no_wolves_alive",
          "reason_args": {
            "wolves": 0,
            "non_wolves": 3
          },
          "status": "open"
        }
      }
    },
    {
      "cmd": {
        "type": "ConfirmWin",
        "payload": {
          "candidate_id": 1
        }
      },
      "expect": {
        "phase": "GAME_OVER",
        "win_candidate": null,
        "winner": {
          "kind": "village",
          "status": "confirmed"
        },
        "events": [
          {
            "type": "WinConfirmed"
          }
        ]
      }
    },
    {
      "cmd": {
        "type": "StartNight",
        "payload": {}
      },
      "reject": "game_over",
      "expect": {
        "phase": "GAME_OVER"
      }
    },
    {
      "cmd": {
        "type": "Nominate",
        "payload": {
          "nominator_id": 3,
          "nominee_id": 4
        }
      },
      "reject": "game_over"
    },
    {
      "cmd": {
        "type": "RejectWin",
        "payload": {
          "candidate_id": 1,
          "reason": "zu spät"
        }
      },
      "reject": "game_over"
    }
  ]
}
