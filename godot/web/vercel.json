{
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
      { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
    ] },
    { "source": "/(.*)[.]wasm", "headers": [ { "key": "Content-Type", "value": "application/wasm" } ] },
    { "source": "/", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/index.html", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/index.service.worker.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/index.manifest.json", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/index.offline.html", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/version.json", "headers": [ { "key": "Cache-Control", "value": "no-cache, no-store" } ] }
  ]
}
